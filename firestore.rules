rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Only the authenticated user can read their own document.
      // Covers both UID-keyed docs and legacy docs with a _authUid field.
      allow read: if request.auth != null &&
                    (request.auth.uid == userId ||
                     request.auth.uid == resource.data._authUid);

      // All client writes are blocked — use Admin SDK / Cloud Functions only.
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
